/dts-v1/;

#include "ipq5018-archer-ax55-common.dtsi"
#include "ipq5018-ess.dtsi"

/ {
	model = "TP-Link Archer AX55 Pro v1";
	compatible = "tplink,archer-ax55-pro-v1", "qcom,ipq5018";
};

/*
 * Stock detects family D (ID 0x6642, revision 0x0050), with HSGMII on
 * CPU port 7 and external WAN port 6. The RTL8221B uses MDIO address 6
 * and active-low GPIO28 reset. GMAC0 uses the integrated GE PHY; GMAC1
 * connects to the switch CPU port over 2.5G HSGMII. Leave switch support
 * pending a compatible family-D driver.
 * Wi-Fi still needs regional board-data selection and radio MAC handling.
 */
&mdio0 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac0 {
	status = "okay";
};

&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&q6v5_wcss {
	status = "disabled";
};

&wifi {
	status = "disabled";
};
