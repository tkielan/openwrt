/dts-v1/;

#include "ipq5018-archer-ax55-common.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

/ {
	model = "TP-Link Archer AX55 v1";
	compatible = "tplink,archer-ax55-v1", "qcom,ipq5018";
};

/*
 * IPQ5018 gmac1 -> uniphy0 -> HSGMII -> RTL8367S port 6.
 * All five jacks are internal switch PHYs: WAN on 0, LAN1-4 on 1-4.
 * The SoC GE PHY is not bonded out, so gmac0 remains disabled.
 */

/*
 * Registering the unused GE PHY deasserts GCC_GEPHY_MISC_ARES, which
 * also gates the MDC/MDIO path shared with mdio1.
 */
&mdio0 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/*
	 * GPIO33, not the OEM-labelled GPIO39, resets the switch. Keep
	 * reset on the switch node so the driver applies its reset delays.
	 */
	switch@1d {
		compatible = "realtek,rtl8365mb";
		reg = <0x1d>;
		reset-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			switchphy0: ethernet-phy@0 {
				reg = <0>;
			};

			switchphy1: ethernet-phy@1 {
				reg = <1>;
			};

			switchphy2: ethernet-phy@2 {
				reg = <2>;
			};

			switchphy3: ethernet-phy@3 {
				reg = <3>;
			};

			switchphy4: ethernet-phy@4 {
				reg = <4>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "wan";
				phy-handle = <&switchphy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&switchphy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&switchphy2>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&switchphy3>;
			};

			port@4 {
				reg = <4>;
				label = "lan4";
				phy-handle = <&switchphy4>;
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
		};
	};
};

/*
 * The 5 GHz radio uses userpd 3 without boot-args, as on GL-B3000.
 * Per-device calibration is extracted from ART by 11-ath11k-caldata.
 */
&q6v5_wcss {
	status = "okay";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,calibration-variant = "TP-Link-Archer-AX55-v1";
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd3>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,calibration-variant = "TP-Link-Archer-AX55-v1";
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
