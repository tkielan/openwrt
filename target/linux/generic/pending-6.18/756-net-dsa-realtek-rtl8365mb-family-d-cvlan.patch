From: Copilot <223556219+Copilot@users.noreply.github.com>
Subject: [PATCH] net: dsa: realtek: rtl8365mb: support family-D CVLAN entries

The RTL8367D stock driver uses the common CVLAN table selector and table
access registers, but its entries contain two 16-bit words: an 8-bit
member mask and 8-bit untag mask in word 0, plus a two-bit FID and IVL
bit in word 1. Family C uses a different three-word entry with wider
fields. Add explicit family-D pack/unpack handling and reject ports and
fields outside the verified family-D widths.

This patch follows the family-D PVID patch, which supplies the family
selector and port bound. It only covers CVLAN table access; family-D
bridge/FID semantics, remaining active DSA callbacks and NCTL
initialization are still unverified. Do not register family D or enable
Ethernet based on this patch alone.

Signed-off-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.c
@@ -75,6 +75,14 @@
 #define RTL8365MB_CVLAN_ENTRY_D2_METERIDX_EXT_MASK	GENMASK(6, 6)
 #define   RTL8365MB_CVLAN_METERIDX_HI_MASK		GENMASK(5, 5)
 
+/* Family-D CVLAN table entry layout, u16[2]. */
+#define RTL8367D_CVLAN_ENTRY_SIZE			2
+#define RTL8367D_CVLAN_ENTRY_D0_MBR_MASK		GENMASK(7, 0)
+#define RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK		GENMASK(15, 8)
+#define RTL8367D_CVLAN_ENTRY_D1_FID_MASK		GENMASK(1, 0)
+#define RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK		BIT(3)
+#define RTL8367D_CVLAN_PORT_MASK			GENMASK(7, 0)
+
 /* VLAN member configuration registers 0~31, u16[3] */
 #define RTL8365MB_VLAN_MC_BASE				0x0728
 #define RTL8365MB_VLAN_MC_ENTRY_SIZE			4 /* 64-bit */
@@ -193,10 +201,14 @@
 	u16 data[RTL8365MB_CVLAN_ENTRY_SIZE];
 	int val;
 	int ret;
+	size_t size = RTL8365MB_CVLAN_ENTRY_SIZE;
+
+	if (rtl8365mb_is_family_d(priv))
+		size = RTL8367D_CVLAN_ENTRY_SIZE;
 
 	ret = rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
 				    RTL8365MB_TABLE_OP_READ, &vid, 0, 0,
-				    data, ARRAY_SIZE(data));
+				    data, size);
 	if (ret)
 		return ret;
 
@@ -204,6 +216,20 @@
 	memset(vlan4k, 0, sizeof(*vlan4k));
 	vlan4k->vid = vid;
 
+	if (rtl8365mb_is_family_d(priv)) {
+		vlan4k->member =
+			FIELD_GET(RTL8367D_CVLAN_ENTRY_D0_MBR_MASK, data[0]);
+		vlan4k->untag =
+			FIELD_GET(RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK, data[0]);
+		vlan4k->fid =
+			FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_FID_MASK, data[1]);
+		vlan4k->ivl_en =
+			FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+				  data[1]);
+
+		return 0;
+	}
+
 	val = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK, data[0]);
 	vlan4k->member = FIELD_PREP(RTL8365MB_CVLAN_MBR_LO_MASK, val);
 	val = FIELD_GET(RTL8365MB_CVLAN_ENTRY_D2_MBR_EXT_MASK, data[2]);
@@ -242,6 +268,28 @@
 	u16 vid;
 	int val;
 
+	if (rtl8365mb_is_family_d(priv)) {
+		if ((vlan4k->member | vlan4k->untag) &
+		    ~RTL8367D_CVLAN_PORT_MASK ||
+		    vlan4k->fid > FIELD_MAX(RTL8367D_CVLAN_ENTRY_D1_FID_MASK))
+			return -EINVAL;
+
+		data[0] = FIELD_PREP(RTL8367D_CVLAN_ENTRY_D0_MBR_MASK,
+				     vlan4k->member) |
+			  FIELD_PREP(RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK,
+				     vlan4k->untag);
+		data[1] = FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_FID_MASK,
+				     vlan4k->fid) |
+			  FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+				     vlan4k->ivl_en);
+
+		vid = vlan4k->vid;
+		return rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
+					     RTL8365MB_TABLE_OP_WRITE, &vid,
+					     0, 0, data,
+					     RTL8367D_CVLAN_ENTRY_SIZE);
+	}
+
 	/* Pack table entry value */
 	val = FIELD_GET(RTL8365MB_CVLAN_MBR_LO_MASK, vlan4k->member);
 	data[0] |= FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK, val);
@@ -301,6 +349,12 @@
 		return -EINVAL;
 	}
 
+	if (rtl8365mb_is_family_d(priv) &&
+	    (port < 0 || port > RTL8367D_MAX_PORT)) {
+		NL_SET_ERR_MSG_MOD(extack, "Invalid family-D switch port");
+		return -EINVAL;
+	}
+
 	ret = rtl8365mb_vlan_4k_read(priv, vlan->vid, &vlan4k);
 	if (ret) {
 		dev_err(priv->dev, "Failed to read VLAN 4k table\n");
